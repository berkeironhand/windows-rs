#[winrt]
mod test_component {
    mod Nested {
        interface IThing {
            fn Method(&self);
        }
    }

    delegate fn Callback(a: i32) -> i32;

    #[repr(u32)]
    #[flags]
    enum Flags {
        Ok = 0,
    }

    #[Windows::Foundation::Metadata::ExclusiveTo(Class)]
    interface IClass {
        #[special]
        fn get_Property(&self) -> i32;
        #[special]
        fn put_Property(&self, value: i32);
        #[special]
        fn get_Flags(&self) -> Flags;
        fn Int32Array(&self, a: [i32], b: &mut [i32], #[output] c: [i32]) -> [i32];
        fn StringArray(
            &self,
            a: [String],
            b: &mut [String],
            #[output] c: [String],
        ) -> [String];
        fn Input(
            &self,
            a: Object,
            b: Class,
            c: Windows::Foundation::IStringable,
            d: Callback,
        );
    }

    #[Windows::Foundation::Metadata::Activatable(1)]
    class Class {
        #[default]
        IClass,
    }
}
