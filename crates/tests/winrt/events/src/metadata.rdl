#[winrt]
mod test_events {
    #[Windows::Foundation::Metadata::ExclusiveTo(Class)]
    interface IClass {
        fn Signal(&self, value: i32) -> i32;
        #[special]
        fn add_Event(
            &self,
            handler: Windows::Foundation::TypedEventHandler<Class, i32>,
        ) -> Windows::Foundation::EventRegistrationToken;
        #[special]
        fn remove_Event(&self, token: Windows::Foundation::EventRegistrationToken);
    }

    #[Windows::Foundation::Metadata::ExclusiveTo(Class)]
    interface IClassStatics {
        fn StaticSignal(&self, value: i32) -> i32;
        #[special]
        fn add_StaticEvent(
            &self,
            handler: Windows::Foundation::EventHandler<i32>,
        ) -> Windows::Foundation::EventRegistrationToken;
        #[special]
        fn remove_StaticEvent(&self, token: Windows::Foundation::EventRegistrationToken);
    }

    #[Windows::Foundation::Metadata::Activatable(1)]
    #[Windows::Foundation::Metadata::Static(IClassStatics, 1)]
    class Class {
        #[default]
        IClass,
    }
}
