#[winrt]
mod test_activation {
    mod One {
        #[Windows::Foundation::Metadata::ExclusiveTo(Instance)]
        interface IInstance {
            #[special]
            fn get_Property(&self) -> i32;
        }

        #[Windows::Foundation::Metadata::Activatable(1)]
        class Instance {
            #[default]
            IInstance,
        }

        #[Windows::Foundation::Metadata::ExclusiveTo(Missing)]
        interface IMissing {
            fn Method(&self);
        }

        #[Windows::Foundation::Metadata::Activatable(1)]
        class Missing {
            #[default]
            IMissing,
        }

        mod Two {
            mod Three {
                mod Four {
                    #[Windows::Foundation::Metadata::ExclusiveTo(Static)]
                    interface IStaticStatics {
                        #[special]
                        fn get_Property(&self) -> i32;
                    }

                    #[Windows::Foundation::Metadata::Static(IStaticStatics, 1)]
                    class Static {}
                }
            }
        }
    }
}
